# Puerto en el que se expondrá la aplicación web en el VPS
PORT=3000

# Credenciales de la base de datos PostgreSQL
# En Render u otro proveedor cloud, usa preferiblemente DATABASE_URL en vez de DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# DATABASE_URL=postgresql://usuario:contrasena@host:5432/base_de_datos
# DB_SSL=true

DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena_segura
DB_NAME=prueba

# (Opcional) Puerto externo si quieres acceder a Postgres desde fuera del VPS (DBeaver / pgAdmin)
# DB_PORT_EXTERNAL=5432
